{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "site-analytics",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",

  // The Worker runs only in front of the site. The route fires only while the
  // johnhoeksema.com DNS records are "Proxied" (orange cloud) in Cloudflare.
  "workers_dev": false,
  "routes": [
    { "pattern": "johnhoeksema.com/*", "zone_name": "johnhoeksema.com" }
  ],

  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-analytics",
      "database_id": "3a2a7940-800a-4fde-9ac8-48f02880e82a"
    }
  ]
}
